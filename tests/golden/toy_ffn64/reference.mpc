from Compiler.types import sint
from Compiler.library import print_ln, check_point
# Party 0 supplies contexts; party 1 supplies the trained model.
x = sint.Matrix(64, 16)
w1 = sint.Matrix(64, 16)
b1 = sint.Array(64)
w2 = sint.Matrix(8, 64)
b2 = sint.Array(8)
x.input_from(0)
w1.input_from(1)
b1.input_from(1)
w2.input_from(1)
b2.input_from(1)
first = x.direct_mul_trans(w1) + (sint.concat([b1.get_vector()] * 64) << 12)
first_bits = first.bit_decompose(64, maybe_mixed=True)[12:]
keep = first_bits[-1].bit_not()
hidden = sint.Matrix(64, 64)
hidden.assign_vector(sint.bit_compose([bit & keep for bit in first_bits], signed=True))
second = hidden.direct_mul_trans(w2)
second_bits = second.bit_decompose(64, maybe_mixed=True)[12:]
output = sint.bit_compose(second_bits, signed=True) + sint.concat([b2.get_vector()] * 64)
revealed = output.reveal()
check_point()
for row in range(64):
    for column in range(8):
        print_ln('LOGIT %s %s %s', row, column, revealed[row * 8 + column])
